# Port the API server listens on
PORT=3000

# Optional shared-secret API key. When set, every /api/* request must send it
# back as the "x-api-key" header (the web UI and the Alexa Lambda both do
# this automatically once configured). Leave blank while developing locally.
API_KEY=

# --- Storage ---
#
# By default the app stores everything in one local JSON file (DB_FILE
# below) - simple, but on most hosting platforms local disk doesn't survive
# redeploys or the service sleeping and waking back up, so your inventory
# would keep getting reset.
#
# Set these two to use Upstash Redis instead (https://console.upstash.com -
# free tier, no credit card, doesn't expire): create a database, open its
# "REST API" section, and copy these two values verbatim - Upstash names
# them exactly this. When both are set, the app uses Redis automatically
# and DB_FILE below is ignored.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Where the local JSON data file lives, when not using Upstash Redis above.
DB_FILE=./data/db.json
